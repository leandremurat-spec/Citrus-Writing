{
  "name": "citrus-writing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs scripts/build-theme-css.ts && node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/tsx/dist/cli.mjs scripts/build-theme-css.ts && node node_modules/tsx/dist/cli.mjs scripts/legal-check.ts && node node_modules/prisma/build/index.js generate && node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "postinstall": "node node_modules/prisma/build/index.js generate",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "postdb:migrate": "node node_modules/prisma/build/index.js generate",
    "db:seed": "node node_modules/prisma/build/index.js db seed",
    "db:reset": "node node_modules/prisma/build/index.js migrate reset --force && node node_modules/prisma/build/index.js generate && node node_modules/prisma/build/index.js db seed",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "db:smoke": "node node_modules/tsx/dist/cli.mjs scripts/db-smoke.ts",
    "db:inspect": "node node_modules/tsx/dist/cli.mjs scripts/db-inspect.ts",
    "export:check": "node node_modules/tsx/dist/cli.mjs scripts/export-check.ts",
    "db:timing": "node node_modules/tsx/dist/cli.mjs scripts/db-write-timing.ts",
    "db:delete-novel": "node node_modules/tsx/dist/cli.mjs scripts/db-delete-novel.ts",
    "config:check": "node node_modules/tsx/dist/cli.mjs scripts/config-check.ts",
    "stripe:check": "node node_modules/tsx/dist/cli.mjs scripts/stripe-check.ts",
    "theme:build": "node node_modules/tsx/dist/cli.mjs scripts/build-theme-css.ts",
    "theme:check": "node node_modules/tsx/dist/cli.mjs scripts/theme-check.ts",
    "legal:check": "node node_modules/tsx/dist/cli.mjs scripts/legal-check.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/driver-adapter-utils": "^7.10.0",
    "@tiptap/core": "^3.31.0",
    "@tiptap/extension-mention": "^3.31.0",
    "@tiptap/extensions": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@tiptap/suggestion": "^3.31.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.3",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.10.0",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
